# Variables de entorno del despliegue (docker-compose.yml). En Coolify se cargan en la pestaña «Environment Variables».
# NO suba un archivo .env real al repositorio. Genere los secretos así:
#   JWT_SECRET: openssl rand -hex 32
#   MFA_KEY:    openssl rand -base64 32      (cifra los secretos del MFA; si se pierde, hay que restablecer el MFA de todos)
#   DB_PASS:    openssl rand -hex 24

# --- Base de datos (PostgreSQL, solo accesible dentro de la red del compose) ---
DB_USER=sisg_app
DB_PASS=
DB_NAME=sisg

# --- Secretos de la API ---
JWT_SECRET=
MFA_KEY=

# --- Dominios (con https://, sin barra final) ---
FRONTEND_URL=https://app.sudominio.com
API_URL=https://api.sudominio.com
# Otros orígenes permitidos por CORS, separados por comas (normalmente vacío)
CORS_ORIGINS=

# --- Comportamiento ---
# true crea/ajusta el esquema al arrancar. Déjelo en true en el primer despliegue; luego conviene false (ver DESPLIEGUE.md).
DB_SYNC=true
# Número de proxies delante de la API (Coolify/Traefik = 1)
TRUST_PROXY=1

# --- Opcional: función «Mensajes con IA» de campañas ---
LOVABLE_API_KEY=
