{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2021", "outDir": "./dist", "rootDir": "./src", "strict": false,
    "declaration": false, "removeComments": true, "emitDecoratorMetadata": true,
    "experimentalDecorators": true, "esModuleInterop": true, "sourceMap": true,
    "skipLibCheck": true, "strictNullChecks": true
  },
  "include": ["src"]
}
