# Copie este archivo a .env y reemplace TODOS los valores. No suba .env al repositorio.
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASS=
DB_NAME=sisg
# Mínimo 32 caracteres aleatorios:  openssl rand -hex 32
JWT_SECRET=
# Clave de 32 bytes en base64 para cifrar los secretos de MFA:  openssl rand -base64 32
MFA_KEY=
# Superadministrador que da de alta las entidades. Se crea la primera vez que arranca la API; contraseña de al menos 10 caracteres.
SUPERADMIN_CORREO=
SUPERADMIN_PASSWORD=
# Opcionales
# FRONTEND_URL=http://localhost:8080
# CORS_ORIGINS=
# NODE_ENV=production   (desactiva la sincronización automática del esquema)
